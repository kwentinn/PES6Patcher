<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research tools for the running game (pes6r.exe): replaces the research/scripts/*.ps1 one command at a time.
       Build once: dotnet build research/Pes6Research -c Release   ->   research/Pes6Research/bin/pes6r.exe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pes6r</AssemblyName>
    <RootNamespace>Pes6Research</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- System.Drawing, for capture (PNG) -->
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pes6Research.Tests" />
    <!-- the patcher's own code, so what is tried live is what the patcher writes (pace) -->
    <ProjectReference Include="..\..\src\PES6Patcher.Core\PES6Patcher.Core.csproj" />
  </ItemGroup>

</Project>
