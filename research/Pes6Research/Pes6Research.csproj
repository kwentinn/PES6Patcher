<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research tools for the running game (pes6r.exe): replaces the research/scripts/*.ps1 one command at a time.
       Build once: dotnet build research/Pes6Research -c Release   ->   research/Pes6Research/bin/pes6r.exe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pes6r</AssemblyName>
    <RootNamespace>Pes6Research</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
